# Base de datos (obligatorio)
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_db

# Twilio WhatsApp (obligatorio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_NUMBER=+14155238886

# AWS S3 (opcional; si no está, las cotizaciones se guardan solo como URL temporal Twilio)
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-east-1
S3_BUCKET_NAME=tu-nombre-de-bucket

# Delta Ingreso AI (módulo WhatsApp + OpenAI)
# TEST_MODE=true  => modo prueba: 17:00 y 17:45 (America/Mexico_City)
# OPENAI_API_KEY=sk-...  => redacción y parseo 5W2H
# DELTA_INGRESO_AI_PERIODO_A=2026-01
# DELTA_INGRESO_AI_PERIODO_B=2026-02

# Director IA (MVP; deshabilitado por defecto si no se define)
# ENABLE_DIRECTOR_IA=true

# Opcionales
# DEBUG=true
# DATABASE_SSL=false
